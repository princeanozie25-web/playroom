# Copy to .env — never commit real values.

# Postgres connection string. `pnpm bootstrap` writes this for you: it starts the Postgres in
# docker-compose.yml when this is empty, or uses whatever you put here if you have your own.
# Compose default: postgres://postgres:postgres@localhost:5433/playroom
DATABASE_URL=
# Test Postgres connection string. Compose default DB: playroom_test (same host/port).
TEST_DATABASE_URL=
# Redis connection string for pub/sub fan-out and ephemeral state.
REDIS_URL=
# LLM provider credential; read only inside packages/adapters/.
ANTHROPIC_API_KEY=
# LLM provider credential; read only inside packages/adapters/.
OPENAI_API_KEY=
# S3-compatible object-storage endpoint URL.
S3_ENDPOINT=
# S3 bucket name for stored artifacts and receipts.
S3_BUCKET=
# Base URL the web client uses to reach the api. Compose/dev default: http://localhost:3001
NEXT_PUBLIC_API_URL=
# A MEMBER CREDENTIAL for the capture harness, so beat 5's request_action frame can
# authenticate at the handshake like any other caller. Issue one with:
#   pnpm tsx scripts/issue-credential.ts prince "capture harness"
# Its own credential, separate from the browser's, so revoking the camera does not lock
# out the dev browser.
PLAYROOM_HARNESS_TOKEN=
# The web app's own member credential, read server-side by the room page and the roster
# fetch. It belongs in apps/web/.env.local (Next reads it there; the root .env is not on
# Next's search path), issued with:
#   pnpm tsx scripts/issue-credential.ts prince "browser (dev)"
# WITHOUT IT THE ROOM DOES NOT RENDER — the socket is refused with close 4401 and the
# roster read returns 401. That is the correct failure: a room drawn with no identity and
# no roster would be a room that looks governed because two fetches failed quietly.
# PLAYROOM_WEB_TOKEN=  (in apps/web/.env.local, not here)
