# Copy to .env — never commit real values.

# Postgres connection string. Compose default: postgres://postgres:postgres@localhost:5433/playroom
DATABASE_URL=
# Test Postgres connection string. Compose default DB: playroom_test (same host/port).
TEST_DATABASE_URL=
# Redis connection string for pub/sub fan-out and ephemeral state.
REDIS_URL=
# LLM provider credential; read only inside packages/adapters/.
ANTHROPIC_API_KEY=
# LLM provider credential; read only inside packages/adapters/.
OPENAI_API_KEY=
# S3-compatible object-storage endpoint URL.
S3_ENDPOINT=
# S3 bucket name for stored artifacts and receipts.
S3_BUCKET=
# Base URL the web client uses to reach the api. Compose/dev default: http://localhost:3001
NEXT_PUBLIC_API_URL=
