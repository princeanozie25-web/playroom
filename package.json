{
  "name": "playroom",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @playroom/api dev",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --check .",
    "verify": "pnpm format && pnpm typecheck && pnpm test",
    "migrate": "tsx scripts/migrate.ts --with-test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pg": "^8.13.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
