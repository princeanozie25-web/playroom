{
  "name": "playroom",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"pnpm --filter @playroom/api dev\" \"pnpm --filter @playroom/web dev\"",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --check .",
    "verify": "pnpm format && pnpm typecheck && pnpm boot-check && pnpm test",
    "migrate": "tsx scripts/migrate.ts --with-test",
    "boot-check": "tsx scripts/esm-boot-check.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "pg": "^8.13.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
